         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Mark Lett, doi:10.1007/s11002-017-9441-6</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Sport sponsoring</rdf:li>
               <rdf:li>League sponsoring</rdf:li>
               <rdf:li>Rivalry effects</rdf:li>
               <rdf:li>Fit</rdf:li>
               <rdf:li>Oppositional loyalty</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Are rival team fans a curse for home team sponsors? The moderating effects of fit, oppositional loyalty, and league sponsoring</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Erik L. Olson</rdf:li>
            </rdf:Seq>
         </dc:creator>
